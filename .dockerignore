# The Dockerfile allow-lists what it copies into the web root; this file is
# defence in depth and keeps the build context small.

# Dependencies and build output
node_modules/
coverage/
dist/
build/

# Tests and tooling
tests/
scripts/
eslint.config.js
vitest.config.js
tsconfig.json
types/
Makefile
package.json
package-lock.json
.prettierrc
.prettierignore
.nvmrc

# CI, VCS and planning artefacts
.github/
.git/
.gitignore
.gitattributes
.planning/
.impeccable/
docs/
plan/

# Agent and editor files
.claude/
CLAUDE.md
AGENTS.md
.vscode/
.idea/

# Docs and licence (not served)
README.md
LICENSE

# Docker's own files
Dockerfile
.dockerignore

# Stale copies and scratch files. The ** prefix is required: a bare *.backup
# only matches at the context root, not resources/js/main.js.backup.
**/*.backup
**/*.bak
**/*.orig
**/*.log
**/*.tmp
**/*.swp

# Design source, not web assets
**/_original/

# OS noise
.DS_Store
Thumbs.db
