# Editor defaults. Prettier owns JS/CSS/HTML/JSON formatting; this covers the
# file types and editor behaviours Prettier does not, and applies before a file
# ever reaches Prettier.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Trailing double-space is a hard line break in Markdown.
trim_trailing_whitespace = false

[Makefile]
# Recipe lines must begin with a real tab.
indent_style = tab
